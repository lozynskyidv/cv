#!/bin/bash
# CV Opener - View generated CVs
# Usage: 
#   ./open              # Open most recent
#   ./open Google       # Open specific CV
#   ./open latest       # Interactive menu

set -e

CV_DIR="resumes"

# Check if resumes directory exists and has PDFs
if [ ! -d "$CV_DIR" ] || [ -z "$(ls -A $CV_DIR/*.pdf 2>/dev/null)" ]; then
    echo "❌ No CVs found in $CV_DIR/"
    echo "Generate a CV first: ./cv Company"
    echo ""
    echo "💡 Run './help' for full command reference"
    exit 1
fi

# Function to open PDF
open_pdf() {
    local pdf="$1"
    if [ -f "$pdf" ]; then
        echo "📄 Opening $(basename "$pdf")..."
        open "$pdf"
    else
        echo "❌ CV not found: $pdf"
        echo ""
        echo "Available CVs:"
        ls "$CV_DIR"/*.pdf 2>/dev/null | xargs -n1 basename | sed 's/Dmytro_Lozynskyi_/  - /' | sed 's/.pdf$//'
        echo ""
        echo "💡 Run './open latest' to browse all CVs"
        exit 1
    fi
}

# Case 1: Interactive menu
if [ "$1" = "latest" ]; then
    echo "📚 Your CVs:"
    echo ""
    
    # Get PDFs sorted by modification time (newest first)
    counter=1
    declare -a files
    declare -a names
    
    while IFS= read -r pdf; do
        filename=$(basename "$pdf" .pdf)
        company=$(echo "$filename" | sed 's/Dmytro_Lozynskyi_//')
        date=$(stat -f "%Sm" -t "%b %d, %Y" "$pdf" 2>/dev/null || stat -c "%y" "$pdf" 2>/dev/null | cut -d' ' -f1)
        
        echo "  $counter. $company ($date)"
        files[$counter]="$pdf"
        names[$counter]="$company"
        counter=$((counter + 1))
    done < <(ls -t "$CV_DIR"/*.pdf)
    
    echo ""
    echo -n "Enter number (or 'q' to quit): "
    read choice
    
    if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
        echo "👋 Cancelled"
        exit 0
    fi
    
    if [ "$choice" -ge 1 ] && [ "$choice" -lt "$counter" ]; then
        open_pdf "${files[$choice]}"
    else
        echo "❌ Invalid choice"
        exit 1
    fi
    exit 0
fi

# Case 2: Open specific company
if [ $# -eq 1 ]; then
    COMPANY="$1"
    PDF="$CV_DIR/Dmytro_Lozynskyi_${COMPANY}.pdf"
    open_pdf "$PDF"
    exit 0
fi

# Case 3: No arguments - open most recent
if [ $# -eq 0 ]; then
    LATEST=$(ls -t "$CV_DIR"/*.pdf | head -1)
    open_pdf "$LATEST"
    exit 0
fi
